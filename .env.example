# Copy to .env.local. Local values come from `pnpm exec supabase status`.
# Cloud values: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Admin scripts and CI ONLY, plus the self-service account-deletion route.
# Never prefix with NEXT_PUBLIC_. Never use it for per-request user actions.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Random secret used to hash IPs on agreement acceptances (never store raw IPs).
# Generate with: openssl rand -hex 32
IP_HASH_SALT=
